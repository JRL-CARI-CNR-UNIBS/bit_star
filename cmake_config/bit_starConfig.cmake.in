@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(graph_core REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

# set_and_check takes a single path: check bit_star's include dir, then append graph_core's ones
set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
list(APPEND @PROJECT_NAME@_INCLUDE_DIRS ${graph_core_INCLUDE_DIRS})
set(@PROJECT_NAME@_LIBRARIES @PROJECT_NAME@ ${graph_core_LIBRARIES})

check_required_components(@PROJECT_NAME@)
